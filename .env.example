# ==============================================================================
# VoxDesk Universal AI Calling Assistant — Environment Template
# Quick Setup for ANY Organization:
#   1. Copy this file to `.env` and fill in your credentials below.
#   2. Copy `config/organization.template.json` to `config/organization.json`
#      and fill in your organization details, hours, services, and policies.
#   3. Run: pnpm db:migrate && pnpm db:seed && pnpm org:validate && pnpm org:apply -- --confirm
# ==============================================================================

# Runtime
NODE_ENV=development
LOG_LEVEL=info
ACTIVE_BUSINESS_ID=

# LiveKit
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Google Gemini Live API
GOOGLE_API_KEY=
GEMINI_LIVE_MODEL=
GEMINI_VOICE=

# Google Calendar
# Option A (recommended for .env): set client email + private key (use \n for newlines in private key)
# Option B (recommended for secrets managers): set GOOGLE_CALENDAR_CREDENTIALS_JSON (raw JSON or base64)
# Option C (local dev fallback): set GOOGLE_CALENDAR_CREDENTIALS_PATH
GOOGLE_CALENDAR_ID=
GOOGLE_CALENDAR_TIME_ZONE=
GOOGLE_CALENDAR_CLIENT_EMAIL=
GOOGLE_CALENDAR_PRIVATE_KEY=
GOOGLE_CALENDAR_CREDENTIALS_JSON=
GOOGLE_CALENDAR_CREDENTIALS_PATH=

# PostgreSQL (Phase 3+)
DATABASE_URL=

# Redis (Phase 4/6+)
REDIS_URL=

# API Auth & Security (Phase 6+)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
API_PORT=

# OpenTelemetry (Phase 9+)
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=

# Booking Confirmation Emails (Gmail SMTP or Resend)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
RESEND_API_KEY=

# Meta WhatsApp Cloud API (Auto Booking Confirmations)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_DEFAULT_COUNTRY_CODE=92
WHATSAPP_TEST_RECIPIENT=
WHATSAPP_TEMPLATE_NAME=
