{
  "name": "aibitsol-ai-receptionist",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"**/*.{ts,js}\"",
    "lint:fix": "eslint --fix \"**/*.{ts,js}\"",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md}\"",
    "test": "vitest --run",
    "test:watch": "vitest",
    "health": "node src/health.ts",
    "health:calendar": "node src/health.ts --check-calendar",
    "db:migrate": "node src/db/migrate.ts",
    "db:seed": "node src/db/seed.ts",
    "api:start": "node src/api/server.ts",
    "frontend:dev": "pnpm --dir apps/frontend dev",
    "frontend:build": "pnpm --dir apps/frontend build",
    "dev": "lk agent dev",
    "start": "node src/main.ts start"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/luxon": "^3.7.6",
    "@types/node": "^24.13.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "jiti": "^2.7.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.3",
    "@fastify/rate-limit": "^11.3.0",
    "@livekit/agents": "^1.9.0",
    "@livekit/agents-plugin-google": "~1.9.1",
    "@livekit/noise-cancellation-node": "^0.3.1",
    "@livekit/rtc-node": "1.1.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.8",
    "googleapis": "^183.0.0",
    "livekit-server-sdk": "^2.20.1",
    "luxon": "^3.7.2",
    "nodemailer": "^10.6.1",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  }
}
